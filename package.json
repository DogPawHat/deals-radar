{
  "name": "deals-radar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --restart-tries=1 --prefix-colors='white.bold.bgCyan,white.bold.bgYellow,white.bold.bgGreen' --prefix=' {name} ' --names='VITE,CONVEX,CONFECT' 'vite' 'convex dev --tail-logs' 'confect dev'",
    "convex-codegen": "confect codegen && convex codegen",
    "dev:web": "vite",
    "dev:convex": "convex dev",
    "dev:confect": "confect dev",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project convex/tsconfig.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@clerk/tanstack-react-start": "^1.0.6",
    "@confect/cli": "^3.0.0",
    "@confect/core": "^3.0.0",
    "@confect/react": "^3.0.0",
    "@confect/server": "^3.0.0",
    "@convex-dev/react-query": "0.1.0",
    "@convex-dev/workflow": "^0.3.7",
    "@convex-dev/workpool": "^0.4.3",
    "@effect/language-service": "^0.82.0",
    "@effect/platform": "0.94.5",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@mendable/firecrawl-js": "^4.17.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@tanstack/react-router": "^1.168.3",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@tanstack/react-start": "^1.167.6",
    "@tanstack/router-plugin": "^1.167.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "confect-workflow": "0.0.0-alpha.3",
    "convex": "^1.34.0",
    "effect": "^3.21.0",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@effect/vitest": "^0.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.43",
    "effect-solutions": "0.4.13",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.17.3",
    "shadcn": "^4.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.1",
    "web-vitals": "^5.1.0"
  }
}
